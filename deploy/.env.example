# Copy to deploy/.env on the VPS (docker compose auto-loads a file named
# exactly ".env" from the directory it's run in). This file controls the
# ORCHESTRATION layer only (which images/tags/ports to run) - it is
# deliberately separate from the app's own runtime secrets, which live in
# ../.env.production and ../apps/api/.env.production instead (see
# .env.example at the repo root and apps/api/.env.example).
#
# deploy/scripts/remote-deploy.sh rewrites only the IMAGE_TAG line in this
# file on every deploy/rollback - everything else here is set once.

# GHCR image repositories built by .github/workflows/deploy.yml. Change the
# "rocmal" owner if the repo is ever forked/moved.
WEB_IMAGE=ghcr.io/rocmal/contentosai-web
API_IMAGE=ghcr.io/rocmal/contentosai-api

# Overwritten automatically by remote-deploy.sh/rollback.sh to a git SHA.
# "latest" is only a safe default for the very first manual `docker compose
# up` before CI has deployed anything.
IMAGE_TAG=latest

# Loopback-only host port Apache's reverse proxy targets for the web
# container (see deploy/apache/). Change only if something else on the
# VPS already uses 3100.
#
# api has no equivalent *_HOST_PORT: it runs with network_mode: host (see
# docker-compose.yml for why - a Redis-reachability workaround), so it
# always binds directly to the host's port 3000 (its own APP_PORT), not a
# docker-mapped port. Apache's proxy target for api is hardcoded to
# 127.0.0.1:3000 in deploy/apache/ for that reason.
WEB_HOST_PORT=3100

# Soft memory ceilings - tune to what the VPS actually has available.
# A container that hits this limit is OOM-killed and restarted by Docker
# (restart: unless-stopped), not the whole VPS.
WEB_MEM_LIMIT=512m
API_MEM_LIMIT=768m
