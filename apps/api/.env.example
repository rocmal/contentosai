# ==========================================================
# APPLICATION
# ==========================================================
APP_NAME=Lumora
APP_ENV=development
APP_PORT=3000
APP_HOST=localhost
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# ==========================================================
# SECURITY
# ==========================================================
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-in-env
JWT_REFRESH_EXPIRES_IN=30d

ENCRYPTION_KEY=change-me-32-characters-long!!

# ==========================================================
# DATABASE
# ==========================================================
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lumora
DB_USER=root
DB_PASSWORD=
DB_LOGGING=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Future PostgreSQL
# DB_DIALECT=postgres

# ==========================================================
# REDIS
# ==========================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================================
# STORAGE
# ==========================================================
STORAGE_PROVIDER=local

LOCAL_STORAGE_PATH=storage

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# MinIO
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lumora

# ==========================================================
# AI PROVIDERS
# ==========================================================
AI_DEFAULT_PROVIDER=openai

OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# ==========================================================
# VIDEO PROVIDERS
# ==========================================================
VEO_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
PIKA_API_KEY=
LUMA_API_KEY=

# ==========================================================
# IMAGE PROVIDERS
# ==========================================================
FLUX_API_KEY=
STABILITY_API_KEY=

# ==========================================================
# VOICE PROVIDERS
# ==========================================================
# edge | azure | elevenlabs | cartesia - "edge" (Microsoft Edge TTS) needs no
# account/key/billing, so it's the default for local development. Azure,
# ElevenLabs and Cartesia stay fully optional/available - set VOICE_PROVIDER
# to switch, no code changes required.
VOICE_PROVIDER=edge

ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
PIPER_BINARY_PATH=
PIPER_VOICES_DIR=
PIPER_DEFAULT_VOICE=en_US-lessac-medium

# ==========================================================
# EMAIL
# ==========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lumora.ai

# ==========================================================
# OAUTH
# ==========================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ==========================================================
# RAZORPAY (billing - primary payment gateway, India-first)
# ==========================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================================
# MONITORING
# ==========================================================
SENTRY_DSN=

# ==========================================================
# ANALYTICS
# ==========================================================
POSTHOG_KEY=

# ==========================================================
# META (Facebook / Instagram publishing)
# ==========================================================
# Required only for real scheduled/automated social posting (Video Studio
# "Fully automated posting"). Leave blank to keep that feature disabled -
# nothing else in the app depends on these.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v21.0

# LinkedIn (member post publishing) - leave blank to keep disabled.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202401

# YouTube (video upload publishing) - reuses GOOGLE_CLIENT_ID/SECRET above
# with this separate redirect URI; add it as an authorized redirect URI on
# that same Google Cloud OAuth client, and enable the YouTube Data API v3.
YOUTUBE_REDIRECT_URI=

# URL of the Vite/React frontend - used to build the Meta OAuth "connect"
# redirect target and the post-callback redirect.
FRONTEND_URL=http://localhost:3000
